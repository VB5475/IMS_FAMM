{
  "name": "famm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:nexus": "npm run dev --workspace=famm-nexus",
    "dev:horizon": "npm run dev --workspace=famm-horizon",
